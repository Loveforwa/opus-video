{
  "bgm": null,
  "bgm_pending": false,
  "voices": [
    {
      "frame": 1,
      "path": "assets/audio/vo/frame-01.mp3",
      "duration_s": 8.388,
      "words": [
        {
          "id": "w0",
          "text": "普信男",
          "start": 0.0,
          "end": 0.844
        },
        {
          "id": "w1",
          "text": "雌竞",
          "start": 0.844,
          "end": 1.476
        },
        {
          "id": "w2",
          "text": "性压抑论",
          "start": 1.476,
          "end": 2.531
        },
        {
          "id": "w3",
          "text": "苹果安卓。",
          "start": 2.531,
          "end": 3.585
        },
        {
          "id": "w4",
          "text": "这几个词随便在评论区说一个",
          "start": 3.585,
          "end": 6.537
        },
        {
          "id": "w5",
          "text": "都能吵上几百楼。",
          "start": 6.537,
          "end": 8.224
        }
      ]
    },
    {
      "frame": 2,
      "path": "assets/audio/vo/frame-02.mp3",
      "duration_s": 15.48,
      "words": [
        {
          "id": "w0",
          "text": "我把这些年中文互联网上的“理论”和“学”整理了一遍",
          "start": 0.0,
          "end": 4.748
        },
        {
          "id": "w1",
          "text": "有两百来个。",
          "start": 4.748,
          "end": 5.844
        },
        {
          "id": "w2",
          "text": "翻完之后发现",
          "start": 5.844,
          "end": 7.123
        },
        {
          "id": "w3",
          "text": "它们的来路分成前后两段",
          "start": 7.123,
          "end": 9.314
        },
        {
          "id": "w4",
          "text": "早些年",
          "start": 9.314,
          "end": 10.045
        },
        {
          "id": "w5",
          "text": "是网友给别人起名字",
          "start": 10.045,
          "end": 11.871
        },
        {
          "id": "w6",
          "text": "最近几年",
          "start": 11.871,
          "end": 12.784
        },
        {
          "id": "w7",
          "text": "越来越多是有人给自己造理论。",
          "start": 12.784,
          "end": 15.341
        }
      ]
    },
    {
      "frame": 3,
      "path": "assets/audio/vo/frame-03.mp3",
      "duration_s": 11.988,
      "words": [
        {
          "id": "w0",
          "text": "先说早些年。",
          "start": 0.0,
          "end": 1.013
        },
        {
          "id": "w1",
          "text": "豆瓣上有一门“晚学”",
          "start": 1.013,
          "end": 2.871
        },
        {
          "id": "w2",
          "text": "研究的是初代网红晚晚和她的丈夫。",
          "start": 2.871,
          "end": 5.574
        },
        {
          "id": "w3",
          "text": "网友一张一张照片找“装富”的破绽",
          "start": 5.574,
          "end": 8.445
        },
        {
          "id": "w4",
          "text": "被她拉黑叫“毕业”",
          "start": 8.445,
          "end": 10.134
        },
        {
          "id": "w5",
          "text": "被删评论叫“延毕”。",
          "start": 10.134,
          "end": 11.823
        }
      ]
    },
    {
      "frame": 4,
      "path": "assets/audio/vo/frame-04.mp3",
      "duration_s": 18.72,
      "words": [
        {
          "id": "w0",
          "text": "晚晚当年确实在经营人设",
          "start": 0.0,
          "end": 2.304
        },
        {
          "id": "w1",
          "text": "可“晚学”这个名字是网友起的",
          "start": 2.304,
          "end": 5.185
        },
        {
          "id": "w2",
          "text": "为的是拆穿她。",
          "start": 5.185,
          "end": 6.529
        },
        {
          "id": "w3",
          "text": "写大冰的“冰学”也是这样",
          "start": 6.729,
          "end": 9.426
        },
        {
          "id": "w4",
          "text": "有篇文章说",
          "start": 9.426,
          "end": 10.67
        },
        {
          "id": "w5",
          "text": "多年前他们有多少拥趸",
          "start": 10.67,
          "end": 12.952
        },
        {
          "id": "w6",
          "text": "如今听来就有多少讽刺。",
          "start": 12.952,
          "end": 15.234
        },
        {
          "id": "w7",
          "text": "那时候",
          "start": 15.234,
          "end": 16.064
        },
        {
          "id": "w8",
          "text": "起名字的权力在观众手里。",
          "start": 16.064,
          "end": 18.553
        }
      ]
    },
    {
      "frame": 5,
      "path": "assets/audio/vo/frame-05.mp3",
      "duration_s": 17.928,
      "words": [
        {
          "id": "w0",
          "text": "到了 2024 年前后",
          "start": 0.0,
          "end": 1.919
        },
        {
          "id": "w1",
          "text": "被研究的人发现",
          "start": 1.919,
          "end": 3.454
        },
        {
          "id": "w2",
          "text": "被研究就是流量。",
          "start": 3.454,
          "end": 4.99
        },
        {
          "id": "w3",
          "text": "叶珂的模仿大赛",
          "start": 4.99,
          "end": 6.525
        },
        {
          "id": "w4",
          "text": "短视频播了 14.3 亿次。",
          "start": 6.525,
          "end": 8.828
        },
        {
          "id": "w5",
          "text": "雷军被做成“雷学”",
          "start": 9.0,
          "end": 10.909
        },
        {
          "id": "w6",
          "text": "营销圈",
          "start": 10.909,
          "end": 11.673
        },
        {
          "id": "w7",
          "text": "汽车圈的人拿着放大镜",
          "start": 11.673,
          "end": 13.773
        },
        {
          "id": "w8",
          "text": "逐帧解读他的直播",
          "start": 13.773,
          "end": 15.491
        },
        {
          "id": "w9",
          "text": "为的是分一瓢泼天的流量。",
          "start": 15.491,
          "end": 17.782
        }
      ]
    },
    {
      "frame": 6,
      "path": "assets/audio/vo/frame-06.mp3",
      "duration_s": 20.664,
      "words": [
        {
          "id": "w0",
          "text": "再往后",
          "start": 0.0,
          "end": 0.689
        },
        {
          "id": "w1",
          "text": "就不用等别人来研究了。",
          "start": 0.689,
          "end": 2.582
        },
        {
          "id": "w2",
          "text": "2025 年",
          "start": 2.736,
          "end": 3.936
        },
        {
          "id": "w3",
          "text": "网上流行起“三大理论”",
          "start": 3.936,
          "end": 6.337
        },
        {
          "id": "w4",
          "text": "峰哥的性压抑论",
          "start": 6.337,
          "end": 7.938
        },
        {
          "id": "w5",
          "text": "说中国男性的精神问题都源于性压抑",
          "start": 7.938,
          "end": 11.339
        },
        {
          "id": "w6",
          "text": "戴梦的力工思维",
          "start": 11.339,
          "end": 12.94
        },
        {
          "id": "w7",
          "text": "说只会埋头付出的男人没有魅力",
          "start": 12.94,
          "end": 15.941
        },
        {
          "id": "w8",
          "text": "户晨风的苹果安卓相对论",
          "start": 16.141,
          "end": 18.32
        },
        {
          "id": "w9",
          "text": "用手机把人分成两个阶层。",
          "start": 18.32,
          "end": 20.499
        }
      ]
    },
    {
      "frame": 7,
      "path": "assets/audio/vo/frame-07.mp3",
      "duration_s": 17.172,
      "words": [
        {
          "id": "w0",
          "text": "性别话题上还有一对。",
          "start": 0.0,
          "end": 2.007
        },
        {
          "id": "w1",
          "text": "“普信男”出自 2020 年的一场脱口秀",
          "start": 2.007,
          "end": 5.821
        },
        {
          "id": "w2",
          "text": "用来说男生",
          "start": 5.821,
          "end": 7.026
        },
        {
          "id": "w3",
          "text": "“雌竞”被拿来说女生之间的互相比较。",
          "start": 7.026,
          "end": 10.639
        },
        {
          "id": "w4",
          "text": "方向相反",
          "start": 10.839,
          "end": 11.836
        },
        {
          "id": "w5",
          "text": "做的是同一件事",
          "start": 11.836,
          "end": 13.431
        },
        {
          "id": "w6",
          "text": "用一个词",
          "start": 13.431,
          "end": 14.428
        },
        {
          "id": "w7",
          "text": "把一个性别打包成一种毛病。",
          "start": 14.428,
          "end": 17.02
        }
      ]
    },
    {
      "frame": 8,
      "path": "assets/audio/vo/frame-08.mp3",
      "duration_s": 17.028,
      "words": [
        {
          "id": "w0",
          "text": "今年 8 月",
          "start": 0.0,
          "end": 0.918
        },
        {
          "id": "w1",
          "text": "又有博主提出“薄肌理论”",
          "start": 0.918,
          "end": 3.304
        },
        {
          "id": "w2",
          "text": "说普通男生练出低体脂的薄肌",
          "start": 3.304,
          "end": 5.874
        },
        {
          "id": "w3",
          "text": "就能拿回人生的控制感",
          "start": 5.874,
          "end": 7.893
        },
        {
          "id": "w4",
          "text": "被网友叫作“第四大理论”。",
          "start": 7.893,
          "end": 10.279
        },
        {
          "id": "w5",
          "text": "孙宇晨更直接",
          "start": 10.479,
          "end": 11.832
        },
        {
          "id": "w6",
          "text": "亲自下场定义“孙学”",
          "start": 11.832,
          "end": 13.958
        },
        {
          "id": "w7",
          "text": "孙学的本质是赢",
          "start": 13.958,
          "end": 15.505
        },
        {
          "id": "w8",
          "text": "你会成为赢家。",
          "start": 15.505,
          "end": 16.858
        }
      ]
    },
    {
      "frame": 9,
      "path": "assets/audio/vo/frame-09.mp3",
      "duration_s": 23.436,
      "words": [
        {
          "id": "w0",
          "text": "这些理论的生产过程很像。",
          "start": 0.0,
          "end": 2.448
        },
        {
          "id": "w1",
          "text": "先抛出一个暴论",
          "start": 2.448,
          "end": 4.08
        },
        {
          "id": "w2",
          "text": "用一个原因解释一大群人",
          "start": 4.08,
          "end": 6.528
        },
        {
          "id": "w3",
          "text": "再造一个好记的名词",
          "start": 6.528,
          "end": 8.568
        },
        {
          "id": "w4",
          "text": "方便大家接龙",
          "start": 8.568,
          "end": 9.996
        },
        {
          "id": "w5",
          "text": "然后给人分边",
          "start": 9.996,
          "end": 11.424
        },
        {
          "id": "w6",
          "text": "评论区自然就吵起来",
          "start": 11.424,
          "end": 13.464
        },
        {
          "id": "w7",
          "text": "吵得越凶",
          "start": 13.464,
          "end": 14.484
        },
        {
          "id": "w8",
          "text": "推得越多",
          "start": 14.484,
          "end": 15.504
        },
        {
          "id": "w9",
          "text": "认同的人开始用他的词说话。",
          "start": 15.704,
          "end": 18.204
        },
        {
          "id": "w10",
          "text": "常见的下一步",
          "start": 18.36,
          "end": 19.634
        },
        {
          "id": "w11",
          "text": "是把流量变成直播间里的收入",
          "start": 19.634,
          "end": 22.183
        },
        {
          "id": "w12",
          "text": "或者一门课。",
          "start": 22.183,
          "end": 23.276
        }
      ]
    },
    {
      "frame": 10,
      "path": "assets/audio/vo/frame-10.mp3",
      "duration_s": 15.444,
      "words": [
        {
          "id": "w0",
          "text": "这条路走到头",
          "start": 0.0,
          "end": 1.468
        },
        {
          "id": "w1",
          "text": "常常是封号。",
          "start": 1.468,
          "end": 2.726
        },
        {
          "id": "w2",
          "text": "2025 年 9 月前后",
          "start": 2.726,
          "end": 4.823
        },
        {
          "id": "w3",
          "text": "三大理论里的后两个遭到审查",
          "start": 4.823,
          "end": 7.758
        },
        {
          "id": "w4",
          "text": "户晨风被全网封禁",
          "start": 7.758,
          "end": 9.645
        },
        {
          "id": "w5",
          "text": "力工思维的原视频也全网删除。",
          "start": 9.645,
          "end": 12.581
        },
        {
          "id": "w6",
          "text": "然后",
          "start": 12.581,
          "end": 13.21
        },
        {
          "id": "w7",
          "text": "下一个理论又出来了。",
          "start": 13.21,
          "end": 15.306
        }
      ]
    },
    {
      "frame": 11,
      "path": "assets/audio/vo/frame-11.mp3",
      "duration_s": 18.864,
      "words": [
        {
          "id": "w0",
          "text": "不过同一时期",
          "start": 0.0,
          "end": 1.21
        },
        {
          "id": "w1",
          "text": "还有另一条线。",
          "start": 1.21,
          "end": 2.419
        },
        {
          "id": "w2",
          "text": "2021 年",
          "start": 2.619,
          "end": 3.852
        },
        {
          "id": "w3",
          "text": "有人在贴吧发帖《躺平即是正义》",
          "start": 3.852,
          "end": 7.138
        },
        {
          "id": "w4",
          "text": "后来大家开始自称牛马",
          "start": 7.138,
          "end": 9.398
        },
        {
          "id": "w5",
          "text": "今年又流行起“耍起”",
          "start": 9.398,
          "end": 11.657
        },
        {
          "id": "w6",
          "text": "出自李伯清几十年前的评书",
          "start": 11.657,
          "end": 14.328
        },
        {
          "id": "w7",
          "text": "耍中找钱",
          "start": 14.328,
          "end": 15.355
        },
        {
          "id": "w8",
          "text": "找钱来耍",
          "start": 15.355,
          "end": 16.382
        },
        {
          "id": "w9",
          "text": "找耍结合",
          "start": 16.582,
          "end": 17.652
        },
        {
          "id": "w10",
          "text": "以耍为主。",
          "start": 17.652,
          "end": 18.722
        }
      ]
    },
    {
      "frame": 12,
      "path": "assets/audio/vo/frame-12.mp3",
      "duration_s": 11.772,
      "words": [
        {
          "id": "w0",
          "text": "这些词没有人靠它收钱。",
          "start": 0.0,
          "end": 2.284
        },
        {
          "id": "w1",
          "text": "“耍起”火了以后",
          "start": 2.284,
          "end": 4.152
        },
        {
          "id": "w2",
          "text": "李伯清本人还出来降温",
          "start": 4.152,
          "end": 6.436
        },
        {
          "id": "w3",
          "text": "说这话是讲给退休的人听的",
          "start": 6.436,
          "end": 9.135
        },
        {
          "id": "w4",
          "text": "年轻人还是要以奋斗为主。",
          "start": 9.135,
          "end": 11.626
        }
      ]
    },
    {
      "frame": 13,
      "path": "assets/audio/vo/frame-13.mp3",
      "duration_s": 30.132,
      "words": [
        {
          "id": "w0",
          "text": "布道这门生意",
          "start": 0.0,
          "end": 1.297
        },
        {
          "id": "w1",
          "text": "历史上一直都有。",
          "start": 1.297,
          "end": 2.779
        },
        {
          "id": "w2",
          "text": "两千多年前的雅典",
          "start": 2.979,
          "end": 4.725
        },
        {
          "id": "w3",
          "text": "智者们周游各城",
          "start": 4.725,
          "end": 6.276
        },
        {
          "id": "w4",
          "text": "收费教人修辞",
          "start": 6.276,
          "end": 7.634
        },
        {
          "id": "w5",
          "text": "教人怎么成功",
          "start": 7.634,
          "end": 8.991
        },
        {
          "id": "w6",
          "text": "晚明有人在市井里聚众讲学",
          "start": 8.991,
          "end": 11.512
        },
        {
          "id": "w7",
          "text": "一百多年前的美国",
          "start": 11.512,
          "end": 13.258
        },
        {
          "id": "w8",
          "text": "巡回演讲的人告诉大家",
          "start": 13.258,
          "end": 15.391
        },
        {
          "id": "w9",
          "text": "先相信",
          "start": 15.391,
          "end": 16.167
        },
        {
          "id": "w10",
          "text": "就能得到。",
          "start": 16.167,
          "end": 17.136
        },
        {
          "id": "w11",
          "text": "后来是成功学讲台",
          "start": 17.28,
          "end": 19.038
        },
        {
          "id": "w12",
          "text": "是知识付费和跨年演讲",
          "start": 19.038,
          "end": 21.186
        },
        {
          "id": "w13",
          "text": "现在是直播间。",
          "start": 21.186,
          "end": 22.553
        },
        {
          "id": "w14",
          "text": "载体越来越短",
          "start": 22.553,
          "end": 23.92
        },
        {
          "id": "w15",
          "text": "理论也越来越短",
          "start": 23.92,
          "end": 25.482
        },
        {
          "id": "w16",
          "text": "从一场三个小时的演讲",
          "start": 25.482,
          "end": 27.631
        },
        {
          "id": "w17",
          "text": "缩成了一个两个字的名词。",
          "start": 27.631,
          "end": 29.974
        }
      ]
    },
    {
      "frame": 14,
      "path": "assets/audio/vo/frame-14.mp3",
      "duration_s": 23.544,
      "words": [
        {
          "id": "w0",
          "text": "这些理论大多在卖同一样东西",
          "start": 0.0,
          "end": 2.645
        },
        {
          "id": "w1",
          "text": "控制感。",
          "start": 2.645,
          "end": 3.4
        },
        {
          "id": "w2",
          "text": "可是当你用别人的理论来解释自己",
          "start": 3.4,
          "end": 6.423
        },
        {
          "id": "w3",
          "text": "解释自己的那支笔",
          "start": 6.423,
          "end": 8.123
        },
        {
          "id": "w4",
          "text": "已经交到别人手里了。",
          "start": 8.123,
          "end": 10.012
        },
        {
          "id": "w5",
          "text": "心理学家弗洛姆在 1941 年写过",
          "start": 10.152,
          "end": 13.27
        },
        {
          "id": "w6",
          "text": "人在不确定的年代",
          "start": 13.27,
          "end": 15.024
        },
        {
          "id": "w7",
          "text": "会主动逃离自由",
          "start": 15.024,
          "end": 16.583
        },
        {
          "id": "w8",
          "text": "躲进权威里。",
          "start": 16.583,
          "end": 17.752
        },
        {
          "id": "w9",
          "text": "今天的权威小了很多",
          "start": 17.752,
          "end": 19.701
        },
        {
          "id": "w10",
          "text": "可能只是一个直播间",
          "start": 19.701,
          "end": 21.65
        },
        {
          "id": "w11",
          "text": "一个两个字的名词。",
          "start": 21.65,
          "end": 23.403
        }
      ]
    },
    {
      "frame": 15,
      "path": "assets/audio/vo/frame-15.mp3",
      "duration_s": 22.392,
      "words": [
        {
          "id": "w0",
          "text": "还有一件更隐蔽的事。",
          "start": 0.0,
          "end": 1.958
        },
        {
          "id": "w1",
          "text": "哲学家伊恩·哈金发现",
          "start": 1.958,
          "end": 4.111
        },
        {
          "id": "w2",
          "text": "给人分类",
          "start": 4.111,
          "end": 5.09
        },
        {
          "id": "w3",
          "text": "会反过来改造被分类的人。",
          "start": 5.09,
          "end": 7.44
        },
        {
          "id": "w4",
          "text": "一个人被叫久了讨好型人格",
          "start": 7.44,
          "end": 9.985
        },
        {
          "id": "w5",
          "text": "就会越来越像讨好型人格。",
          "start": 9.985,
          "end": 12.334
        },
        {
          "id": "w6",
          "text": "当我们形容自己和别人的词",
          "start": 12.492,
          "end": 15.304
        },
        {
          "id": "w7",
          "text": "只剩下力工",
          "start": 15.304,
          "end": 16.602
        },
        {
          "id": "w8",
          "text": "普信",
          "start": 16.602,
          "end": 17.251
        },
        {
          "id": "w9",
          "text": "龟男",
          "start": 17.251,
          "end": 17.9
        },
        {
          "id": "w10",
          "text": "回避型",
          "start": 17.9,
          "end": 18.765
        },
        {
          "id": "w11",
          "text": "我们的世界也就缩成了这几个格子。",
          "start": 18.765,
          "end": 22.226
        }
      ]
    },
    {
      "frame": 16,
      "path": "assets/audio/vo/frame-16.mp3",
      "duration_s": 12.24,
      "words": [
        {
          "id": "w0",
          "text": "这也不全是主播的错。",
          "start": 0.0,
          "end": 1.862
        },
        {
          "id": "w1",
          "text": "在一个奖励简单答案的市场里",
          "start": 1.862,
          "end": 4.468
        },
        {
          "id": "w2",
          "text": "谁说得越绝对",
          "start": 4.468,
          "end": 5.772
        },
        {
          "id": "w3",
          "text": "谁就跑得越快。",
          "start": 5.772,
          "end": 7.075
        },
        {
          "id": "w4",
          "text": "这个市场奖励什么",
          "start": 7.075,
          "end": 8.751
        },
        {
          "id": "w5",
          "text": "取决于我们为什么停下来",
          "start": 8.751,
          "end": 10.985
        },
        {
          "id": "w6",
          "text": "为什么转发。",
          "start": 10.985,
          "end": 12.102
        }
      ]
    },
    {
      "frame": 17,
      "path": "assets/audio/vo/frame-17.mp3",
      "duration_s": 36.144,
      "words": [
        {
          "id": "w0",
          "text": "十几年前",
          "start": 0.0,
          "end": 0.894
        },
        {
          "id": "w1",
          "text": "网友一起写“晚学”",
          "start": 0.894,
          "end": 2.683
        },
        {
          "id": "w2",
          "text": "是一群普通人在拆穿一个人设。",
          "start": 2.683,
          "end": 5.187
        },
        {
          "id": "w3",
          "text": "今天有人一起说“耍起”“牛马”",
          "start": 5.187,
          "end": 8.049
        },
        {
          "id": "w4",
          "text": "也是在给自己的日子起名字",
          "start": 8.049,
          "end": 10.374
        },
        {
          "id": "w5",
          "text": "没人从中收钱。",
          "start": 10.374,
          "end": 11.626
        },
        {
          "id": "w6",
          "text": "一起起名字",
          "start": 11.772,
          "end": 12.922
        },
        {
          "id": "w7",
          "text": "能让人互相看见",
          "start": 12.922,
          "end": 14.455
        },
        {
          "id": "w8",
          "text": "从别人那里买一个名字",
          "start": 14.455,
          "end": 16.563
        },
        {
          "id": "w9",
          "text": "人就被分进了格子。",
          "start": 16.563,
          "end": 18.288
        },
        {
          "id": "w10",
          "text": "两千多年前的雅典",
          "start": 18.288,
          "end": 20.012
        },
        {
          "id": "w11",
          "text": "苏格拉底没提出过任何理论",
          "start": 20.012,
          "end": 22.504
        },
        {
          "id": "w12",
          "text": "他只是一直在问。",
          "start": 22.504,
          "end": 24.037
        },
        {
          "id": "w13",
          "text": "下次再刷到一个新理论",
          "start": 24.192,
          "end": 26.593
        },
        {
          "id": "w14",
          "text": "先别急着对号入座",
          "start": 26.593,
          "end": 28.558
        },
        {
          "id": "w15",
          "text": "问问自己",
          "start": 28.558,
          "end": 29.65
        },
        {
          "id": "w16",
          "text": "它能不能被反驳？",
          "start": 29.65,
          "end": 31.396
        },
        {
          "id": "w17",
          "text": "说它的人在卖什么？",
          "start": 31.396,
          "end": 33.361
        },
        {
          "id": "w18",
          "text": "把名字拿掉",
          "start": 33.361,
          "end": 34.671
        },
        {
          "id": "w19",
          "text": "还剩下什么？",
          "start": 34.671,
          "end": 35.981
        }
      ]
    }
  ],
  "sfx": []
}