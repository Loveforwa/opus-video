{
  "bgm": null,
  "bgm_pending": false,
  "voices": [
    {
      "frame": 1,
      "path": "assets/audio/vo/frame-01.mp3",
      "duration_s": 8.352,
      "words": [
        {
          "id": "w0",
          "text": "27 届秋招已经开始了。",
          "start": 0.0,
          "end": 2.047
        },
        {
          "id": "w1",
          "text": "河南师范大学一个同学",
          "start": 2.047,
          "end": 4.095
        },
        {
          "id": "w2",
          "text": "投了四五十份简历",
          "start": 4.095,
          "end": 5.77
        },
        {
          "id": "w3",
          "text": "到现在只等来一次大厂面试。",
          "start": 5.77,
          "end": 8.19
        }
      ]
    },
    {
      "frame": 2,
      "path": "assets/audio/vo/frame-02.mp3",
      "duration_s": 8.496,
      "words": [
        {
          "id": "w0",
          "text": "这一届毕业生有 1270 万",
          "start": 0.0,
          "end": 2.585
        },
        {
          "id": "w1",
          "text": "历年最多。",
          "start": 2.585,
          "end": 3.579
        },
        {
          "id": "w2",
          "text": "今年 8 月",
          "start": 3.579,
          "end": 4.574
        },
        {
          "id": "w3",
          "text": "16 到 24 岁的青年失业率是 18.9%。",
          "start": 4.574,
          "end": 8.352
        }
      ]
    },
    {
      "frame": 3,
      "path": "assets/audio/vo/frame-03.mp3",
      "duration_s": 19.512,
      "words": [
        {
          "id": "w0",
          "text": "很多人转去考公。",
          "start": 0.0,
          "end": 1.574
        },
        {
          "id": "w1",
          "text": "今年国考过审 371.8 万人",
          "start": 1.574,
          "end": 4.329
        },
        {
          "id": "w2",
          "text": "第一次比考研的 343 万还多。",
          "start": 4.329,
          "end": 7.085
        },
        {
          "id": "w3",
          "text": "可那位同学说",
          "start": 7.085,
          "end": 8.462
        },
        {
          "id": "w4",
          "text": "比她大一届的五个朋友",
          "start": 8.462,
          "end": 10.627
        },
        {
          "id": "w5",
          "text": "四个毕业后待业",
          "start": 10.627,
          "end": 12.201
        },
        {
          "id": "w6",
          "text": "考公考编一个都没考上。",
          "start": 12.201,
          "end": 14.366
        },
        {
          "id": "w7",
          "text": "她的原话是",
          "start": 14.508,
          "end": 15.629
        },
        {
          "id": "w8",
          "text": "所有人都在挤的路",
          "start": 15.629,
          "end": 17.31
        },
        {
          "id": "w9",
          "text": "未必比市场化就业更稳。",
          "start": 17.31,
          "end": 19.365
        }
      ]
    },
    {
      "frame": 4,
      "path": "assets/audio/vo/frame-04.mp3",
      "duration_s": 13.968,
      "words": [
        {
          "id": "w0",
          "text": "大厂这边",
          "start": 0.0,
          "end": 1.016
        },
        {
          "id": "w1",
          "text": "几乎都在招 AI。",
          "start": 1.016,
          "end": 2.642
        },
        {
          "id": "w2",
          "text": "脉脉的数据",
          "start": 2.642,
          "end": 3.862
        },
        {
          "id": "w3",
          "text": "今年前五个月新发的校招 AI 岗位",
          "start": 3.862,
          "end": 7.113
        },
        {
          "id": "w4",
          "text": "比去年同期多了 47%。",
          "start": 7.113,
          "end": 9.349
        },
        {
          "id": "w5",
          "text": "阿里 AI 相关岗位超过六成",
          "start": 9.349,
          "end": 11.991
        },
        {
          "id": "w6",
          "text": "有的公司超过九成。",
          "start": 11.991,
          "end": 13.82
        }
      ]
    },
    {
      "frame": 5,
      "path": "assets/audio/vo/frame-05.mp3",
      "duration_s": 12.888,
      "words": [
        {
          "id": "w0",
          "text": "那学计算机还行吗？",
          "start": 0.0,
          "end": 1.685
        },
        {
          "id": "w1",
          "text": "一位 985 软件工程的研究生跟记者说",
          "start": 1.685,
          "end": 5.054
        },
        {
          "id": "w2",
          "text": "纯做软件开发可能没什么前途了",
          "start": 5.054,
          "end": 7.862
        },
        {
          "id": "w3",
          "text": "太卷了。",
          "start": 7.862,
          "end": 8.611
        },
        {
          "id": "w4",
          "text": "他还说",
          "start": 8.611,
          "end": 9.36
        },
        {
          "id": "w5",
          "text": "AI 岗占比看着高",
          "start": 9.36,
          "end": 11.044
        },
        {
          "id": "w6",
          "text": "岗位总数其实少了。",
          "start": 11.044,
          "end": 12.729
        }
      ]
    },
    {
      "frame": 6,
      "path": "assets/audio/vo/frame-06.mp3",
      "duration_s": 9.648,
      "words": [
        {
          "id": "w0",
          "text": "麦可思今年评出的六个绿牌专业",
          "start": 0.0,
          "end": 2.901
        },
        {
          "id": "w1",
          "text": "一个计算机都没有",
          "start": 2.901,
          "end": 4.642
        },
        {
          "id": "w2",
          "text": "全是电气",
          "start": 4.642,
          "end": 5.61
        },
        {
          "id": "w3",
          "text": "微电子",
          "start": 5.61,
          "end": 6.383
        },
        {
          "id": "w4",
          "text": "自动化",
          "start": 6.383,
          "end": 7.157
        },
        {
          "id": "w5",
          "text": "能源动力",
          "start": 7.157,
          "end": 8.124
        },
        {
          "id": "w6",
          "text": "车辆和新能源。",
          "start": 8.124,
          "end": 9.478
        }
      ]
    },
    {
      "frame": 7,
      "path": "assets/audio/vo/frame-07.mp3",
      "duration_s": 13.32,
      "words": [
        {
          "id": "w0",
          "text": "再往后五年",
          "start": 0.0,
          "end": 1.112
        },
        {
          "id": "w1",
          "text": "我的判断是",
          "start": 1.112,
          "end": 2.224
        },
        {
          "id": "w2",
          "text": "写代码会变得像搜索一样普通。",
          "start": 2.224,
          "end": 4.819
        },
        {
          "id": "w3",
          "text": "程序员值钱的地方会挪到别处",
          "start": 4.819,
          "end": 7.413
        },
        {
          "id": "w4",
          "text": "想清楚要解决什么问题",
          "start": 7.413,
          "end": 9.452
        },
        {
          "id": "w5",
          "text": "判断 AI 写的东西对不对",
          "start": 9.452,
          "end": 11.676
        },
        {
          "id": "w6",
          "text": "出了事能兜得住。",
          "start": 11.676,
          "end": 13.159
        }
      ]
    },
    {
      "frame": 8,
      "path": "assets/audio/vo/frame-08.mp3",
      "duration_s": 35.424,
      "words": [
        {
          "id": "w0",
          "text": "说说十个热门专业。",
          "start": 0.0,
          "end": 1.816
        },
        {
          "id": "w1",
          "text": "下面是我根据这些数据做的推测",
          "start": 1.816,
          "end": 4.842
        },
        {
          "id": "w2",
          "text": "不是定论。",
          "start": 4.842,
          "end": 5.851
        },
        {
          "id": "w3",
          "text": "电子信息",
          "start": 5.851,
          "end": 6.86
        },
        {
          "id": "w4",
          "text": "电气",
          "start": 6.86,
          "end": 7.465
        },
        {
          "id": "w5",
          "text": "新能源",
          "start": 7.465,
          "end": 8.272
        },
        {
          "id": "w6",
          "text": "五年内最稳。",
          "start": 8.272,
          "end": 9.483
        },
        {
          "id": "w7",
          "text": "人工智能最热",
          "start": 9.483,
          "end": 10.895
        },
        {
          "id": "w8",
          "text": "门槛也在涨。",
          "start": 10.895,
          "end": 12.106
        },
        {
          "id": "w9",
          "text": "临床医学来得慢",
          "start": 12.106,
          "end": 13.72
        },
        {
          "id": "w10",
          "text": "但不太怕 AI。",
          "start": 13.72,
          "end": 15.132
        },
        {
          "id": "w11",
          "text": "计算机",
          "start": 15.3,
          "end": 16.11
        },
        {
          "id": "w12",
          "text": "金融",
          "start": 16.11,
          "end": 16.718
        },
        {
          "id": "w13",
          "text": "法学",
          "start": 16.718,
          "end": 17.325
        },
        {
          "id": "w14",
          "text": "基础岗会被 AI 挤掉一部分",
          "start": 17.325,
          "end": 19.958
        },
        {
          "id": "w15",
          "text": "懂行业又会用 AI 的人更好找工作。",
          "start": 19.958,
          "end": 23.198
        },
        {
          "id": "w16",
          "text": "土木还得看房地产",
          "start": 23.198,
          "end": 25.021
        },
        {
          "id": "w17",
          "text": "今年前八个月开发投资降了近两成。",
          "start": 25.021,
          "end": 28.261
        },
        {
          "id": "w18",
          "text": "师范要面对出生人口",
          "start": 28.461,
          "end": 30.468
        },
        {
          "id": "w19",
          "text": "去年只有 792 万。",
          "start": 30.468,
          "end": 32.274
        },
        {
          "id": "w20",
          "text": "新闻传播的传统岗位还在变少。",
          "start": 32.436,
          "end": 35.273
        }
      ]
    },
    {
      "frame": 9,
      "path": "assets/audio/vo/frame-09.mp3",
      "duration_s": 10.8,
      "words": [
        {
          "id": "w0",
          "text": "今年网上还火了一个词",
          "start": 0.0,
          "end": 2.208
        },
        {
          "id": "w1",
          "text": "叫“耍起”。",
          "start": 2.208,
          "end": 3.413
        },
        {
          "id": "w2",
          "text": "出处是李伯清几十年前的一段评书",
          "start": 3.413,
          "end": 6.624
        },
        {
          "id": "w3",
          "text": "耍中找钱",
          "start": 6.624,
          "end": 7.628
        },
        {
          "id": "w4",
          "text": "找钱来耍",
          "start": 7.628,
          "end": 8.632
        },
        {
          "id": "w5",
          "text": "找耍结合",
          "start": 8.632,
          "end": 9.636
        },
        {
          "id": "w6",
          "text": "以耍为主。",
          "start": 9.636,
          "end": 10.639
        }
      ]
    },
    {
      "frame": 10,
      "path": "assets/audio/vo/frame-10.mp3",
      "duration_s": 16.524,
      "words": [
        {
          "id": "w0",
          "text": "这句话为什么能火？",
          "start": 0.0,
          "end": 1.599
        },
        {
          "id": "w1",
          "text": "我的理解是",
          "start": 1.599,
          "end": 2.666
        },
        {
          "id": "w2",
          "text": "很多人发现拼命往前冲",
          "start": 2.666,
          "end": 4.62
        },
        {
          "id": "w3",
          "text": "回报越来越说不准",
          "start": 4.62,
          "end": 6.22
        },
        {
          "id": "w4",
          "text": "那就先把眼前的日子过好。",
          "start": 6.22,
          "end": 8.352
        },
        {
          "id": "w5",
          "text": "它和躺平还不太一样",
          "start": 8.552,
          "end": 10.411
        },
        {
          "id": "w6",
          "text": "班照上",
          "start": 10.411,
          "end": 11.154
        },
        {
          "id": "w7",
          "text": "简历照投",
          "start": 11.154,
          "end": 12.084
        },
        {
          "id": "w8",
          "text": "只是不想再为一个看不清的将来",
          "start": 12.084,
          "end": 14.872
        },
        {
          "id": "w9",
          "text": "把自己绷到极限。",
          "start": 14.872,
          "end": 16.358
        }
      ]
    },
    {
      "frame": 11,
      "path": "assets/audio/vo/frame-11.mp3",
      "duration_s": 26.604,
      "words": [
        {
          "id": "w0",
          "text": "历史上",
          "start": 0.0,
          "end": 0.843
        },
        {
          "id": "w1",
          "text": "九十年代的日本有点像。",
          "start": 0.843,
          "end": 3.161
        },
        {
          "id": "w2",
          "text": "泡沫破了",
          "start": 3.161,
          "end": 4.215
        },
        {
          "id": "w3",
          "text": "毕业生扎堆找工作",
          "start": 4.215,
          "end": 6.111
        },
        {
          "id": "w4",
          "text": "年轻人干脆降低欲望。",
          "start": 6.111,
          "end": 8.218
        },
        {
          "id": "w5",
          "text": "那一代人确实吃了亏。",
          "start": 8.218,
          "end": 10.326
        },
        {
          "id": "w6",
          "text": "有研究比较过日本和美国",
          "start": 10.476,
          "end": 13.069
        },
        {
          "id": "w7",
          "text": "同样在经济差的年份毕业",
          "start": 13.069,
          "end": 15.662
        },
        {
          "id": "w8",
          "text": "美国人几年后就追了上来",
          "start": 15.662,
          "end": 18.256
        },
        {
          "id": "w9",
          "text": "日本人受的影响拖得更久",
          "start": 18.256,
          "end": 20.849
        },
        {
          "id": "w10",
          "text": "一个原因是日本企业习惯只招应届生",
          "start": 20.849,
          "end": 24.523
        },
        {
          "id": "w11",
          "text": "错过就很难再进去。",
          "start": 24.523,
          "end": 26.467
        }
      ]
    },
    {
      "frame": 12,
      "path": "assets/audio/vo/frame-12.mp3",
      "duration_s": 29.772,
      "words": [
        {
          "id": "w0",
          "text": "对我们来说",
          "start": 0.0,
          "end": 1.071
        },
        {
          "id": "w1",
          "text": "第一份工作不理想",
          "start": 1.071,
          "end": 2.679
        },
        {
          "id": "w2",
          "text": "别把它当终点。",
          "start": 2.679,
          "end": 3.929
        },
        {
          "id": "w3",
          "text": "加拿大有个长期研究",
          "start": 4.129,
          "end": 6.058
        },
        {
          "id": "w4",
          "text": "在经济衰退时毕业的人",
          "start": 6.058,
          "end": 8.181
        },
        {
          "id": "w5",
          "text": "起薪平均低大约百分之九",
          "start": 8.181,
          "end": 10.497
        },
        {
          "id": "w6",
          "text": "差不多十年后",
          "start": 10.497,
          "end": 11.848
        },
        {
          "id": "w7",
          "text": "这个差距基本就没了",
          "start": 11.848,
          "end": 13.777
        },
        {
          "id": "w8",
          "text": "主要靠换工作",
          "start": 13.777,
          "end": 15.128
        },
        {
          "id": "w9",
          "text": "换到更好的公司。",
          "start": 15.128,
          "end": 16.672
        },
        {
          "id": "w10",
          "text": "李伯清后来也出来说",
          "start": 16.812,
          "end": 18.783
        },
        {
          "id": "w11",
          "text": "那十六个字是说给退休的人听的",
          "start": 18.783,
          "end": 21.739
        },
        {
          "id": "w12",
          "text": "年轻人还是要以奋斗为主。",
          "start": 21.739,
          "end": 24.104
        },
        {
          "id": "w13",
          "text": "想耍就耍",
          "start": 24.104,
          "end": 25.089
        },
        {
          "id": "w14",
          "text": "简历也接着投。",
          "start": 25.089,
          "end": 26.469
        },
        {
          "id": "w15",
          "text": "行情差的时候",
          "start": 26.469,
          "end": 27.849
        },
        {
          "id": "w16",
          "text": "往前挪一点也算数。",
          "start": 27.849,
          "end": 29.622
        }
      ]
    }
  ],
  "sfx": []
}