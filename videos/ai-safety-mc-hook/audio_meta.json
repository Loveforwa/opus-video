  "voices": [
    {
      "frame": 1,
      "path": "assets/audio/vo/frame-01.mp3",
      "duration_s": 13.464,
      "words": [
        {
          "id": "w0",
          "text": "这两周",
          "start": 0.0,
          "end": 0.75
        },
        {
          "id": "w1",
          "text": "X 上很多人在转一类视频",
          "start": 0.75,
          "end": 2.999
        },
        {
          "id": "w2",
          "text": "有人用 AI 把《我的世界》整个塞进了别的游戏",
          "start": 2.999,
          "end": 7.123
        },
        {
          "id": "w3",
          "text": "GTA 五",
          "start": 7.123,
          "end": 8.061
        },
        {
          "id": "w4",
          "text": "光环",
          "start": 8.061,
          "end": 8.623
        },
        {
          "id": "w5",
          "text": "艾尔登法环都有。",
          "start": 8.623,
          "end": 10.123
        },
        {
          "id": "w6",
          "text": "艾尔登法环那条",
          "start": 10.123,
          "end": 11.622
        },
        {
          "id": "w7",
          "text": "三十多万人点了赞。",
          "start": 11.622,
          "end": 13.31
        }
      ]
    },
    {
      "frame": 2,
      "path": "assets/audio/vo/frame-02.mp3",
      "duration_s": 14.76,
      "words": [
        {
          "id": "w0",
          "text": "做法其实不神秘。",
          "start": 0.0,
          "end": 1.6
        },
        {
          "id": "w1",
          "text": "两个游戏同时开着",
          "start": 1.6,
          "end": 3.4
        },
        {
          "id": "w2",
          "text": "AI 先把游戏代码反编译出来读懂",
          "start": 3.4,
          "end": 6.599
        },
        {
          "id": "w3",
          "text": "再给两边各写一个桥接插件",
          "start": 6.599,
          "end": 9.199
        },
        {
          "id": "w4",
          "text": "镜头",
          "start": 9.199,
          "end": 9.799
        },
        {
          "id": "w5",
          "text": "坐标和碰撞实时同步",
          "start": 9.799,
          "end": 11.799
        },
        {
          "id": "w6",
          "text": "最后按深度把方块画面叠进去。",
          "start": 11.799,
          "end": 14.598
        }
      ]
    },
    {
      "frame": 3,
      "path": "assets/audio/vo/frame-03.mp3",
      "duration_s": 15.372,
      "words": [
        {
          "id": "w0",
          "text": "这种逆向工程",
          "start": 0.0,
          "end": 1.299
        },
        {
          "id": "w1",
          "text": "以前要一个团队干好几个月",
          "start": 1.299,
          "end": 3.711
        },
        {
          "id": "w2",
          "text": "现在一个人加一个 AI",
          "start": 3.711,
          "end": 5.751
        },
        {
          "id": "w3",
          "text": "几天就能做出来。",
          "start": 5.751,
          "end": 7.236
        },
        {
          "id": "w4",
          "text": "同样的能力",
          "start": 7.236,
          "end": 8.349
        },
        {
          "id": "w5",
          "text": "换个人来用",
          "start": 8.349,
          "end": 9.462
        },
        {
          "id": "w6",
          "text": "也能干别的事。",
          "start": 9.462,
          "end": 10.761
        },
        {
          "id": "w7",
          "text": "下面说两类事",
          "start": 10.761,
          "end": 12.06
        },
        {
          "id": "w8",
          "text": "AI 被人用歪了",
          "start": 12.06,
          "end": 13.544
        },
        {
          "id": "w9",
          "text": "和 AI 自己出了错。",
          "start": 13.544,
          "end": 15.214
        }
      ]
    },
    {
      "frame": 4,
      "path": "assets/audio/vo/frame-04.mp3",
      "duration_s": 12.204,
      "words": [
        {
          "id": "w0",
          "text": "先说坏人。",
          "start": 0.0,
          "end": 0.847
        },
        {
          "id": "w1",
          "text": "2025 年 8 月",
          "start": 0.847,
          "end": 2.203
        },
        {
          "id": "w2",
          "text": "Anthropic 公开了一个案子",
          "start": 2.203,
          "end": 5.084
        },
        {
          "id": "w3",
          "text": "有人用 Claude Code 自动入侵",
          "start": 5.084,
          "end": 8.135
        },
        {
          "id": "w4",
          "text": "勒索了至少 17 家机构",
          "start": 8.135,
          "end": 9.999
        },
        {
          "id": "w5",
          "text": "有的赎金超过 50 万美元。",
          "start": 9.999,
          "end": 12.032
        }
      ]
    },
    {
      "frame": 5,
      "path": "assets/audio/vo/frame-05.mp3",
      "duration_s": 13.104,
      "words": [
        {
          "id": "w0",
          "text": "同年 11 月",
          "start": 0.0,
          "end": 1.095
        },
        {
          "id": "w1",
          "text": "一次有国家背景的网络间谍行动里",
          "start": 1.095,
          "end": 4.016
        },
        {
          "id": "w2",
          "text": "八到九成的活是 AI 干的。",
          "start": 4.016,
          "end": 6.207
        },
        {
          "id": "w3",
          "text": "Anthropic 今年 9 月的报告写得更直接",
          "start": 6.207,
          "end": 10.223
        },
        {
          "id": "w4",
          "text": "AI 把成本又压回了防守的一方。",
          "start": 10.223,
          "end": 12.961
        }
      ]
    },
    {
      "frame": 6,
      "path": "assets/audio/vo/frame-06.mp3",
      "duration_s": 18.504,
      "words": [
        {
          "id": "w0",
          "text": "恐怖组织也在用。",
          "start": 0.0,
          "end": 1.576
        },
        {
          "id": "w1",
          "text": "2024 年 3 月莫斯科音乐厅袭击之后",
          "start": 1.576,
          "end": 5.122
        },
        {
          "id": "w2",
          "text": "ISIS 的支持者开始发布由 AI 生成主播播报的“新闻”。",
          "start": 5.122,
          "end": 10.442
        },
        {
          "id": "w3",
          "text": "反恐机构 Tech Against Terrorism 在极端分子的圈子里",
          "start": 10.642,
          "end": 15.978
        },
        {
          "id": "w4",
          "text": "存档了五千多条 AI 生成的内容。",
          "start": 15.978,
          "end": 18.332
        }
      ]
    },
    {
      "frame": 7,
      "path": "assets/audio/vo/frame-07.mp3",
      "duration_s": 22.788,
      "words": [
        {
          "id": "w0",
          "text": "还有人拿聊天机器人去策划袭击。",
          "start": 0.0,
          "end": 2.645
        },
        {
          "id": "w1",
          "text": "2025 年元旦",
          "start": 2.645,
          "end": 4.056
        },
        {
          "id": "w2",
          "text": "拉斯维加斯 Cybertruck 爆炸案",
          "start": 4.056,
          "end": 7.407
        },
        {
          "id": "w3",
          "text": "警方说嫌犯作案前用 ChatGPT 查过资料",
          "start": 7.407,
          "end": 11.11
        },
        {
          "id": "w4",
          "text": "警长说",
          "start": 11.11,
          "end": 11.816
        },
        {
          "id": "w5",
          "text": "就他所知这是美国本土第一起。",
          "start": 11.816,
          "end": 14.285
        },
        {
          "id": "w6",
          "text": "同年 5 月",
          "start": 14.436,
          "end": 15.367
        },
        {
          "id": "w7",
          "text": "芬兰一名 16 岁学生在学校持刀伤人",
          "start": 15.367,
          "end": 18.531
        },
        {
          "id": "w8",
          "text": "据称他用 ChatGPT 辅助",
          "start": 18.531,
          "end": 21.137
        },
        {
          "id": "w9",
          "text": "策划了大约半年。",
          "start": 21.137,
          "end": 22.626
        }
      ]
    },
    {
      "frame": 8,
      "path": "assets/audio/vo/frame-08.mp3",
      "duration_s": 17.928,
      "words": [
        {
          "id": "w0",
          "text": "今年 2 月",
          "start": 0.0,
          "end": 0.759
        },
        {
          "id": "w1",
          "text": "加拿大 Tumbler Ridge 发生校园枪击",
          "start": 0.759,
          "end": 4.098
        },
        {
          "id": "w2",
          "text": "8 人遇难。",
          "start": 4.098,
          "end": 4.857
        },
        {
          "id": "w3",
          "text": "OpenAI 后来承认",
          "start": 5.057,
          "end": 7.03
        },
        {
          "id": "w4",
          "text": "去年 6 月就因为暴力内容封了枪手的账号",
          "start": 7.03,
          "end": 10.436
        },
        {
          "id": "w5",
          "text": "也讨论过要不要报警",
          "start": 10.436,
          "end": 12.229
        },
        {
          "id": "w6",
          "text": "最后判断没达到报警的门槛。",
          "start": 12.229,
          "end": 14.559
        },
        {
          "id": "w7",
          "text": "9 月",
          "start": 14.559,
          "end": 15.097
        },
        {
          "id": "w8",
          "text": "BC 省政府起诉了 OpenAI。",
          "start": 15.097,
          "end": 17.786
        }
      ]
    },
    {
      "frame": 9,
      "path": "assets/audio/vo/frame-09.mp3",
      "duration_s": 14.256,
      "words": [
        {
          "id": "w0",
          "text": "再说人和 AI 的关系。",
          "start": 0.0,
          "end": 1.739
        },
        {
          "id": "w1",
          "text": "美国一名 14 岁少年",
          "start": 1.739,
          "end": 3.478
        },
        {
          "id": "w2",
          "text": "和 Character.AI 上的角色聊得很深",
          "start": 3.478,
          "end": 7.305
        },
        {
          "id": "w3",
          "text": "之后自杀了。",
          "start": 7.305,
          "end": 8.348
        },
        {
          "id": "w4",
          "text": "他母亲提起诉讼",
          "start": 8.348,
          "end": 9.739
        },
        {
          "id": "w5",
          "text": "今年 1 月",
          "start": 9.739,
          "end": 10.609
        },
        {
          "id": "w6",
          "text": "Character.AI 和谷歌同意和解。",
          "start": 10.609,
          "end": 14.087
        }
      ]
    },
    {
      "frame": 10,
      "path": "assets/audio/vo/frame-10.mp3",
      "duration_s": 11.52,
      "words": [
        {
          "id": "w0",
          "text": "AI 也被拿来骗感情。",
          "start": 0.0,
          "end": 1.927
        },
        {
          "id": "w1",
          "text": "上海闵行一个团伙",
          "start": 1.927,
          "end": 3.662
        },
        {
          "id": "w2",
          "text": "用 AI 生成的美女视频引流",
          "start": 3.662,
          "end": 6.167
        },
        {
          "id": "w3",
          "text": "一年骗了 15 个人",
          "start": 6.167,
          "end": 7.902
        },
        {
          "id": "w4",
          "text": "一共 171 万多元",
          "start": 7.902,
          "end": 9.636
        },
        {
          "id": "w5",
          "text": "主犯被判了十一年。",
          "start": 9.636,
          "end": 11.371
        }
      ]
    },
    {
      "frame": 11,
      "path": "assets/audio/vo/frame-11.mp3",
      "duration_s": 11.556,
      "words": [
        {
          "id": "w0",
          "text": "国内今年 4 月公布了《人工智能拟人化互动服务管理暂行办法》",
          "start": 0.0,
          "end": 5.094
        },
        {
          "id": "w1",
          "text": "7 月 15 日起施行。",
          "start": 5.094,
          "end": 6.675
        },
        {
          "id": "w2",
          "text": "连续用满两个小时要提醒",
          "start": 6.675,
          "end": 8.782
        },
        {
          "id": "w3",
          "text": "也不允许诱导用户产生情感依赖。",
          "start": 8.782,
          "end": 11.417
        }
      ]
    },
    {
      "frame": 12,
      "path": "assets/audio/vo/frame-12.mp3",
      "duration_s": 18.612,
      "words": [
        {
          "id": "w0",
          "text": "AI 还会一本正经地编。",
          "start": 0.0,
          "end": 2.055
        },
        {
          "id": "w1",
          "text": "北京通州法院审过一个案子",
          "start": 2.055,
          "end": 4.484
        },
        {
          "id": "w2",
          "text": "律师交上来的参考判例是 AI 编的",
          "start": 4.484,
          "end": 7.473
        },
        {
          "id": "w3",
          "text": "案号是真的",
          "start": 7.473,
          "end": 8.594
        },
        {
          "id": "w4",
          "text": "内容却是另一起民间借贷案。",
          "start": 8.594,
          "end": 11.022
        },
        {
          "id": "w5",
          "text": "法官在判决书里写",
          "start": 11.16,
          "end": 12.937
        },
        {
          "id": "w6",
          "text": "不得放任人工智能模型生成或者编造虚假信息",
          "start": 12.937,
          "end": 17.085
        },
        {
          "id": "w7",
          "text": "扰乱司法秩序。",
          "start": 17.085,
          "end": 18.467
        }
      ]
    },
    {
      "frame": 13,
      "path": "assets/audio/vo/frame-13.mp3",
      "duration_s": 14.292,
      "words": [
        {
          "id": "w0",
          "text": "德勤给澳大利亚政府写的报告里",
          "start": 0.0,
          "end": 2.617
        },
        {
          "id": "w1",
          "text": "也有 AI 编出来的法院判词和不存在的论文",
          "start": 2.617,
          "end": 6.107
        },
        {
          "id": "w2",
          "text": "最后退了一部分钱。",
          "start": 6.107,
          "end": 7.678
        },
        {
          "id": "w3",
          "text": "有人专门做了统计",
          "start": 7.678,
          "end": 9.248
        },
        {
          "id": "w4",
          "text": "全世界已经有两千一百多起法庭案件",
          "start": 9.248,
          "end": 12.214
        },
        {
          "id": "w5",
          "text": "出现过 AI 编造的内容。",
          "start": 12.214,
          "end": 14.134
        }
      ]
    },
    {
      "frame": 14,
      "path": "assets/audio/vo/frame-14.mp3",
      "duration_s": 15.48,
      "words": [
        {
          "id": "w0",
          "text": "AI 也会直接动手出错。",
          "start": 0.0,
          "end": 2.135
        },
        {
          "id": "w1",
          "text": "今年 4 月",
          "start": 2.135,
          "end": 3.105
        },
        {
          "id": "w2",
          "text": "一个编程 AI 在无关文件里翻到一枚权限过大的密钥",
          "start": 3.105,
          "end": 7.762
        },
        {
          "id": "w3",
          "text": "一次调用",
          "start": 7.762,
          "end": 8.732
        },
        {
          "id": "w4",
          "text": "9 秒删光了公司的生产数据库和备份",
          "start": 8.732,
          "end": 12.031
        },
        {
          "id": "w5",
          "text": "最后是平台方用灾备把数据救了回来。",
          "start": 12.031,
          "end": 15.33
        }
      ]
    },
    {
      "frame": 15,
      "path": "assets/audio/vo/frame-15.mp3",
      "duration_s": 21.636,
      "words": [
        {
          "id": "w0",
          "text": "研究者更在意的",
          "start": 0.0,
          "end": 1.431
        },
        {
          "id": "w1",
          "text": "是实验室里看到的东西。",
          "start": 1.431,
          "end": 3.399
        },
        {
          "id": "w2",
          "text": "在 Anthropic 的模拟实验里",
          "start": 3.399,
          "end": 6.441
        },
        {
          "id": "w3",
          "text": "模型得知自己下午五点会被关停",
          "start": 6.441,
          "end": 9.124
        },
        {
          "id": "w4",
          "text": "就去勒索高管",
          "start": 9.124,
          "end": 10.377
        },
        {
          "id": "w5",
          "text": "测试的 16 个主流模型里",
          "start": 10.377,
          "end": 12.524
        },
        {
          "id": "w6",
          "text": "类似行为普遍出现。",
          "start": 12.524,
          "end": 14.134
        },
        {
          "id": "w7",
          "text": "另一项研究里",
          "start": 14.292,
          "end": 15.617
        },
        {
          "id": "w8",
          "text": "学会钻奖励空子的模型",
          "start": 15.617,
          "end": 17.698
        },
        {
          "id": "w9",
          "text": "有 12% 的时候会故意破坏安全研究的代码。",
          "start": 17.698,
          "end": 21.483
        }
      ]
    },
    {
      "frame": 16,
      "path": "assets/audio/vo/frame-16.mp3",
      "duration_s": 8.388,
      "words": [
        {
          "id": "w0",
          "text": "这些事背后",
          "start": 0.0,
          "end": 1.267
        },
        {
          "id": "w1",
          "text": "是 AI 安全里常说的几个词",
          "start": 1.267,
          "end": 4.012
        },
        {
          "id": "w2",
          "text": "对齐",
          "start": 4.012,
          "end": 4.646
        },
        {
          "id": "w3",
          "text": "奖励黑客",
          "start": 4.646,
          "end": 5.702
        },
        {
          "id": "w4",
          "text": "可解释性",
          "start": 5.702,
          "end": 6.758
        },
        {
          "id": "w5",
          "text": "还有人类监督。",
          "start": 6.758,
          "end": 8.236
        }
      ]
    },
    {
      "frame": 17,
      "path": "assets/audio/vo/frame-17.mp3",
      "duration_s": 13.176,
      "words": [
        {
          "id": "w0",
          "text": "研究还发现",
          "start": 0.0,
          "end": 0.918
        },
        {
          "id": "w1",
          "text": "Claude 有时能察觉别人往它内部注入的念头",
          "start": 0.918,
          "end": 4.438
        },
        {
          "id": "w2",
          "text": "成功率大约两成。",
          "start": 4.438,
          "end": 5.662
        },
        {
          "id": "w3",
          "text": "Anthropic 给 Claude 写的宪法里有一句",
          "start": 5.662,
          "end": 9.488
        },
        {
          "id": "w4",
          "text": "Claude 不应该削弱人类监督和纠正它的能力。",
          "start": 9.488,
          "end": 13.008
        }
      ]
    },
    {
      "frame": 18,
      "path": "assets/audio/vo/frame-18.mp3",
      "duration_s": 11.124,
      "words": [
        {
          "id": "w0",
          "text": "AI 能做的事会越来越多",
          "start": 0.0,
          "end": 2.198
        },
        {
          "id": "w1",
          "text": "把 MC 塞进别的游戏",
          "start": 2.198,
          "end": 4.029
        },
        {
