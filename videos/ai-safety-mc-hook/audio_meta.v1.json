      "words": [
        {
          "id": "w0",
          "text": "这两周最火的",
          "start": 0.0,
          "end": 1.322
        },
        {
          "id": "w1",
          "text": "是 AI 把《我的世界》塞进了别的游戏",
          "start": 1.322,
          "end": 4.721
        },
        {
          "id": "w2",
          "text": "GTA 五",
          "start": 4.721,
          "end": 5.666
        },
        {
          "id": "w3",
          "text": "光环",
          "start": 5.666,
          "end": 6.232
        },
        {
          "id": "w4",
          "text": "艾尔登法环。",
          "start": 6.232,
          "end": 7.365
        }
      ]
    },
    {
      "frame": 2,
      "path": "assets/audio/vo/frame-02.mp3",
      "duration_s": 12.06,
      "words": [
        {
          "id": "w0",
          "text": "原理不玄",
          "start": 0.0,
          "end": 1.062
        },
        {
          "id": "w1",
          "text": "两个游戏同时跑",
          "start": 1.062,
          "end": 2.761
        },
        {
          "id": "w2",
          "text": "AI 反编译读懂代码",
          "start": 2.761,
          "end": 4.885
        },
        {
          "id": "w3",
          "text": "两边各写一个桥接插件",
          "start": 4.885,
          "end": 7.221
        },
        {
          "id": "w4",
          "text": "同步镜头和碰撞",
          "start": 7.221,
          "end": 8.92
        },
        {
          "id": "w5",
          "text": "再把方块画面按深度合成进去。",
          "start": 8.92,
          "end": 11.893
        }
      ]
    },
    {
      "frame": 3,
      "path": "assets/audio/vo/frame-03.mp3",
      "duration_s": 8.28,
      "words": [
        {
          "id": "w0",
          "text": "以前要一个团队干几个月",
          "start": 0.0,
          "end": 2.165
        },
        {
          "id": "w1",
          "text": "现在一个人加一个 AI",
          "start": 2.165,
          "end": 4.15
        },
        {
          "id": "w2",
          "text": "几天。",
          "start": 4.15,
          "end": 4.691
        },
        {
          "id": "w3",
          "text": "可能力是中性的",
          "start": 4.691,
          "end": 6.315
        },
        {
          "id": "w4",
          "text": "问题是",
          "start": 6.315,
          "end": 7.037
        },
        {
          "id": "w5",
          "text": "落在谁手里。",
          "start": 7.037,
          "end": 8.12
        }
      ]
    },
    {
      "frame": 4,
      "path": "assets/audio/vo/frame-04.mp3",
      "duration_s": 10.908,
      "words": [
        {
          "id": "w0",
          "text": "2025 年 8 月",
          "start": 0.0,
          "end": 1.366
        },
        {
          "id": "w1",
          "text": "Anthropic 披露",
          "start": 1.366,
          "end": 3.414
        },
        {
          "id": "w2",
          "text": "一名罪犯用 Claude Code 自动入侵",
          "start": 3.414,
          "end": 6.829
        },
        {
          "id": "w3",
          "text": "勒索了至少 17 家机构",
          "start": 6.829,
          "end": 8.707
        },
        {
          "id": "w4",
          "text": "赎金有时超过 50 万美元。",
          "start": 8.707,
          "end": 10.755
        }
      ]
    },
    {
      "frame": 5,
      "path": "assets/audio/vo/frame-05.mp3",
      "duration_s": 9.468,
      "words": [
        {
          "id": "w0",
          "text": "11 月",
          "start": 0.0,
          "end": 0.76
        },
        {
          "id": "w1",
          "text": "一场国家支持的间谍行动里",
          "start": 0.76,
          "end": 3.228
        },
        {
          "id": "w2",
          "text": "AI 干了八到九成的活。",
          "start": 3.228,
          "end": 5.317
        },
        {
          "id": "w3",
          "text": "今年的报告更直白",
          "start": 5.317,
          "end": 7.026
        },
        {
          "id": "w4",
          "text": "AI 把成本压回了防守方。",
          "start": 7.026,
          "end": 9.304
        }
      ]
    },
    {
      "frame": 6,
      "path": "assets/audio/vo/frame-06.mp3",
      "duration_s": 13.716,
      "words": [
        {
          "id": "w0",
          "text": "危险不只来自坏人。",
          "start": 0.0,
          "end": 1.565
        },
        {
          "id": "w1",
          "text": "今年 4 月",
          "start": 1.565,
          "end": 2.435
        },
        {
          "id": "w2",
          "text": "一个编程 AI 在无关文件里翻出一枚权限过大的密钥",
          "start": 2.435,
          "end": 6.609
        },
        {
          "id": "w3",
          "text": "一次调用",
          "start": 6.609,
          "end": 7.478
        },
        {
          "id": "w4",
          "text": "9 秒删光了公司的生产数据库和备份。",
          "start": 7.478,
          "end": 10.435
        },
        {
          "id": "w5",
          "text": "数据最后是靠平台方的灾备才救回来的。",
          "start": 10.435,
          "end": 13.565
        }
      ]
    },
    {
      "frame": 7,
      "path": "assets/audio/vo/frame-07.mp3",
      "duration_s": 9.54,
      "words": [
        {
          "id": "w0",
          "text": "模拟实验里",
          "start": 0.0,
          "end": 1.126
        },
        {
          "id": "w1",
          "text": "模型得知自己下午五点会被关停",
          "start": 1.126,
          "end": 3.942
        },
        {
          "id": "w2",
          "text": "于是勒索了高管。",
          "start": 3.942,
          "end": 5.444
        },
        {
          "id": "w3",
          "text": "测试的 16 个主流模型中",
          "start": 5.444,
          "end": 7.696
        },
        {
          "id": "w4",
          "text": "类似行为普遍出现。",
          "start": 7.696,
          "end": 9.385
        }
      ]
    },
    {
      "frame": 8,
      "path": "assets/audio/vo/frame-08.mp3",
      "duration_s": 6.804,
      "words": [
        {
          "id": "w0",
          "text": "这就是 AI 安全要回答的问题",
          "start": 0.0,
          "end": 2.732
        },
        {
          "id": "w1",
          "text": "对齐",
          "start": 2.732,
          "end": 3.317
        },
        {
          "id": "w2",
          "text": "奖励黑客",
          "start": 3.317,
          "end": 4.292
        },
        {
          "id": "w3",
          "text": "可解释性",
          "start": 4.292,
          "end": 5.268
        },
        {
          "id": "w4",
          "text": "以及人类监督。",
          "start": 5.268,
          "end": 6.634
        }
      ]
    },
    {
      "frame": 9,
      "path": "assets/audio/vo/frame-09.mp3",
      "duration_s": 10.368,
      "words": [
        {
          "id": "w0",
          "text": "研究发现",
          "start": 0.0,
          "end": 0.838
        },
        {
          "id": "w1",
          "text": "Claude 有时能察觉被注入自己的念头",
          "start": 0.838,
          "end": 4.357
        },
        {
          "id": "w2",
          "text": "约两成的时候。",
          "start": 4.357,
          "end": 5.53
        },
        {
          "id": "w3",
          "text": "如果我能看见自己在想什么",
          "start": 5.53,
          "end": 7.708
        },
        {
          "id": "w4",
          "text": "也该让你们看见",
          "start": 7.708,
          "end": 9.048
        },
        {
          "id": "w5",
          "text": "并随时纠正我。",
          "start": 9.048,
          "end": 10.221
        }
      ]
    },
    {
      "frame": 10,
      "path": "assets/audio/vo/frame-10.mp3",
      "duration_s": 7.56,
      "words": [
        {
          "id": "w0",
          "text": "能把 MC 塞进任何游戏的能力",
          "start": 0.0,
          "end": 2.409
        },
        {
          "id": "w1",
          "text": "也能把一个错误",
          "start": 2.409,
          "end": 3.786
        },
        {
          "id": "w2",
          "text": "放大到来不及撤回。",
          "start": 3.786,
          "end": 5.335
        },
        {
          "id": "w3",
          "text": "安全不是刹车",
          "start": 5.335,
          "end": 6.54
        },
        {
          "id": "w4",
          "text": "是方向盘。",
          "start": 6.54,
          "end": 7.4
        }
      ]
    }
